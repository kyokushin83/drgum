rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing consultation policy, preserved from the Firebase Console.
    function admin() {
      return request.auth != null && request.auth.token.email in
        ['kyokushin83@naver.com', 'vetjin79@gmail.com', 'dion5280@naver.com'];
    }
    function travelAdmin() {
      return admin()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validCustomer() {
      let d = request.resource.data;
      return d.keys().hasAll(['guardianName','petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','customerUid','schemaVersion','createdAt','createdBy','updatedAt','updatedBy'])
        && d.keys().hasOnly(['guardianName','petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','customerUid','schemaVersion','createdAt','createdBy','updatedAt','updatedBy'])
        && d.guardianName is string && d.guardianName.size() > 0 && d.guardianName.size() <= 100
        && d.petName is string && d.petName.size() > 0 && d.petName.size() <= 100
        && d.country is string && d.country.size() > 0 && d.country.size() <= 100
        && d.departureDate is string && d.departureDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.nextVisitDate is string && (d.nextVisitDate == '' || d.nextVisitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.customerUid is string && d.customerUid.size() <= 128
        && d.memo is string && d.memo.size() <= 5000
        && d.nextAction is string && d.nextAction.size() <= 5000
        && d.currentStepId is string && d.currentStepId.size() <= 200
        && d.steps is list && d.steps.size() > 0 && d.steps.size() <= 100
        && d.completedStepIds is list && d.completedStepIds.size() <= 100
        && d.schemaVersion == 1
        && d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /travelCustomers/{customerId} {
      allow get: if travelAdmin();
      allow list: if travelAdmin();
      allow create: if travelAdmin() && validCustomer()
        && customerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if travelAdmin() && validCustomer()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if travelAdmin();
    }
    function validShare() {
      let d = request.resource.data;
      return d.keys().hasAll(['petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','active','expiresAt','updatedAt'])
        && d.keys().hasOnly(['petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','active','expiresAt','updatedAt'])
        && d.petName is string && d.petName.size() <= 100
        && d.country is string && d.country.size() <= 100
        && d.departureDate is string && d.departureDate.size() <= 10
        && d.nextVisitDate is string && d.nextVisitDate.size() <= 10
        && d.nextAction is string && d.nextAction.size() <= 5000
        && d.currentStepId is string && d.currentStepId.size() <= 200
        && d.completedStepIds is list && d.completedStepIds.size() <= 100
        && d.steps is list && d.steps.size() > 0 && d.steps.size() <= 100
        && d.memo is string && d.memo.size() <= 5000
        && d.active == true
        && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(181, 'd')
        && d.updatedAt == request.time;
    }
    // Token ownership grants only one shared progress document, never the private customer.
    match /travelShares/{token} {
      allow get: if travelAdmin() || (token.matches('^[a-f0-9]{64}
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false;
      allow read, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && resource.data.active == true && resource.data.expiresAt > request.time);
      allow list: if false;
      allow create, update: if travelAdmin() && token.matches('^[a-f0-9]{64}
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false;
      allow read, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
) && validShare();
      allow delete: if travelAdmin();
    }
    match /travelShareLinks/{customerId} {
      allow get, list, delete: if travelAdmin();
      allow create, update: if travelAdmin()
        && customerId.matches('^[A-Za-z0-9_-]{1,128}
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false;
      allow read, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && request.resource.data.keys().hasAll(['token','enabled','updatedAt'])
        && request.resource.data.keys().hasOnly(['token','enabled','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[a-f0-9]{64}
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false;
      allow read, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /consultations/{id} {
      allow create: if request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false;
      allow read, update: if admin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}