rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server-enforced allowlist, matching the existing consultation administrators.
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in ['kyokushin83@naver.com', 'vetjin79@gmail.com', 'dion5280@naver.com'];
    }
    function validCustomer() {
      let d = request.resource.data;
      return d.keys().hasAll(['guardianName','petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','customerUid','schemaVersion','createdAt','createdBy','updatedAt','updatedBy'])
        && d.keys().hasOnly(['guardianName','petName','country','departureDate','nextVisitDate','nextAction','currentStepId','completedStepIds','steps','memo','customerUid','schemaVersion','createdAt','createdBy','updatedAt','updatedBy'])
        && d.guardianName is string && d.guardianName.size() > 0 && d.guardianName.size() <= 100
        && d.petName is string && d.petName.size() > 0 && d.petName.size() <= 100
        && d.country is string && d.country.size() > 0 && d.country.size() <= 100
        && d.departureDate is string && d.departureDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.nextVisitDate is string && (d.nextVisitDate == '' || d.nextVisitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.customerUid is string && d.customerUid.size() <= 128
        && d.memo is string && d.memo.size() <= 5000
        && d.nextAction is string && d.nextAction.size() <= 5000
        && d.currentStepId is string && d.currentStepId.size() <= 200
        && d.steps is list && d.steps.size() > 0 && d.steps.size() <= 100
        && d.completedStepIds is list && d.completedStepIds.size() <= 100
        && d.schemaVersion == 1
        && d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /travelCustomers/{customerId} {
      allow get: if admin() || (request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && resource.data.customerUid == request.auth.uid);
      allow list: if admin();
      allow create: if admin() && validCustomer()
        && customerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && validCustomer()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if admin();
    }
    // Existing public booking form: create only, with bounded payload and server timestamp.
    match /consultations/{consultationId} {
      allow read, update, delete: if admin();
      allow create: if request.resource.data.keys().hasAll(['phone','country','departureDate','pet','registered','total','firstVisit','status','called','createdAt'])
        && request.resource.data.keys().hasOnly(['phone','country','departureDate','pet','registered','total','firstVisit','status','called','createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+() -]{9,20}$')
        && request.resource.data.country is string && request.resource.data.country.size() <= 100
        && request.resource.data.departureDate is string && request.resource.data.departureDate.size() <= 20
        && request.resource.data.pet is string && request.resource.data.pet.size() <= 100
        && request.resource.data.registered in ['등록','미등록']
        && request.resource.data.total is string && request.resource.data.total.size() <= 100
        && request.resource.data.firstVisit is string && request.resource.data.firstVisit.size() <= 200
        && request.resource.data.status == '미연락'
        && request.resource.data.called == false
        && request.resource.data.createdAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
